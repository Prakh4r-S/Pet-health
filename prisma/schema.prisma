// Pet Healthcare — Milestone 1 schema
// Covers: accounts, multi-species pet profiles, weight history,
// vaccinations with due dates, allergies, conditions.
// Deliberately excludes: consultations, documents, community, insurance.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}


enum Role {
  OWNER
  VET
}


// ---------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pets     Pet[]
  accounts Account[]
  sessions Session[]
  role       Role        @default(OWNER)
  vetProfile VetProfile?
  appointments Appointment[]

  uploadedDocuments Document[] @relation("UploadedDocuments")
  amendments NoteAmendment[]

}

// ---------------------------------------------------------------
// Reference data (seeded, not user-editable)
// ---------------------------------------------------------------

model Species {
  id        String  @id @default(cuid())
  name      String  @unique // "Dog", "Cat", "Rabbit"
  slug      String  @unique
  careNotes String? // markdown shown on the profile page

  breeds       Breed[]
  vaccineTypes VaccineType[]
  pets         Pet[]
}

model Breed {
  id                   String   @id @default(cuid())
  speciesId            String
  name                 String
  slug                 String
  careNotes            String?
  adultWeightMinKg     Decimal? @db.Decimal(6, 2)
  adultWeightMaxKg     Decimal? @db.Decimal(6, 2)
  typicalLifespanYears Int?

  species Species @relation(fields: [speciesId], references: [id])
  pets    Pet[]

  @@unique([speciesId, slug])
  @@index([speciesId])
}

model VaccineType {
  id                    String  @id @default(cuid())
  speciesId             String
  name                  String // "Rabies", "DHPP", "FVRCP"
  slug                  String
  isCore                Boolean @default(false)
  defaultIntervalMonths Int? // null = single dose, no recurrence

  species      Species       @relation(fields: [speciesId], references: [id])
  vaccinations Vaccination[]

  @@unique([speciesId, slug])
}

// ---------------------------------------------------------------
// Pets
// ---------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

model Pet {
  id                String    @id @default(cuid())
  ownerId           String
  speciesId         String
  breedId           String? // null when unknown or mixed
  breedFreeText     String? // escape hatch: "Lab x Indie mix"
  name              String
  sex               Sex       @default(UNKNOWN)
  birthDate         DateTime? @db.Date
  birthDateIsApprox Boolean   @default(false) // rescues rarely have exact dates
  neutered          Boolean?
  microchipNumber   String?
  photoUrl          String?
  archivedAt        DateTime? // soft delete: records outlive the pet
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species    Species            @relation(fields: [speciesId], references: [id])
  breed      Breed?             @relation(fields: [breedId], references: [id])
  weights    WeightLog[]
  vaccinations Vaccination[]
  allergies  Allergy[]
  conditions MedicalCondition[]
  appointments Appointment[]

  documents Document[]
  prescriptions Prescription[]

  @@index([ownerId, archivedAt])
}

// ---------------------------------------------------------------
// Health records
// ---------------------------------------------------------------

model WeightLog {
  id         String   @id @default(cuid())
  petId      String
  weightKg   Decimal  @db.Decimal(6, 3)
  measuredAt DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@unique([petId, measuredAt]) // one canonical weight per day
  @@index([petId, measuredAt])
}

model Vaccination {
  id             String    @id @default(cuid())
  petId          String
  vaccineTypeId  String
  administeredOn DateTime  @db.Date
  nextDueOn      DateTime? @db.Date // computed on write from defaultIntervalMonths
  administeredBy String? // clinic or vet name, free text for now
  batchNumber    String?
  note           String?
  createdAt      DateTime  @default(now())

  pet         Pet         @relation(fields: [petId], references: [id], onDelete: Cascade)
  vaccineType VaccineType @relation(fields: [vaccineTypeId], references: [id])

  @@index([petId, administeredOn])
  @@index([nextDueOn]) // drives the "what's due" query
}

enum Severity {
  MILD
  MODERATE
  SEVERE
  UNKNOWN
}

model Allergy {
  id          String    @id @default(cuid())
  petId       String
  allergen    String
  reaction    String?
  severity    Severity  @default(UNKNOWN)
  diagnosedOn DateTime? @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, active])
}

model MedicalCondition {
  id          String    @id @default(cuid())
  petId       String
  name        String
  notes       String?
  diagnosedOn DateTime? @db.Date
  resolvedOn  DateTime? @db.Date // null = ongoing
  createdAt   DateTime  @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, resolvedOn])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


model VetProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  licenceNumber  String
  bio            String?
  yearsExperience Int?
  clinicName     String?
  city           String?
  // IANA name, e.g. "Asia/Kolkata". Availability below is expressed in
  // this zone; without it, a window stored as 09:00–17:00 is meaningless
  // to anyone in a different timezone.
  timezone       String    @default("Asia/Kolkata")
  slotMinutes    Int       @default(30)
  // Set when an admin approves the vet. Nullable because an unverified
  // vet exists but should not be bookable — a real product would check
  // the licence number against a veterinary council register here.
  verifiedAt     DateTime?
  acceptingNewPatients Boolean @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisations Specialisation[]
  availability    VetAvailability[]
  timeOff         VetTimeOff[]
  appointments Appointment[]
  @@index([verifiedAt, acceptingNewPatients])

  notes ConsultationNote[]
}

model Specialisation {
  id   String @id @default(cuid())
  name String @unique // "Dermatology", "Orthopaedics", "Exotics"
  slug String @unique

  vets VetProfile[]
}
/// A recurring weekly window during which the vet takes appointments.
///
/// Times are stored as minutes from midnight rather than as DateTime or
/// Time columns. A recurring window has no date, so a DateTime would
/// carry a meaningless day component, and Prisma's Time handling varies
/// by driver. An integer is unambiguous, trivially comparable, and easy
/// to slice into slots of slotMinutes each.
model VetAvailability {
  id           String @id @default(cuid())
  vetProfileId String
  dayOfWeek    Int // 0 = Sunday ... 6 = Saturday
  startMinute  Int // 540 = 09:00
  endMinute    Int // 1020 = 17:00

  vetProfile VetProfile @relation(fields: [vetProfileId], references: [id], onDelete: Cascade)

  @@index([vetProfileId, dayOfWeek])
}

/// A one-off absence that overrides the recurring pattern — holiday,
/// conference, sick day. Stored as absolute instants because these are
/// real points in time, not weekly abstractions.
model VetTimeOff {
  id           String   @id @default(cuid())
  vetProfileId String
  startsAt     DateTime
  endsAt       DateTime
  reason       String?

  vetProfile VetProfile @relation(fields: [vetProfileId], references: [id], onDelete: Cascade)

  @@index([vetProfileId, startsAt])
}


enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id           String            @id @default(cuid())
  petId        String
  ownerId      String
  vetProfileId String
  startsAt     DateTime
  endsAt       DateTime
  status       AppointmentStatus @default(SCHEDULED)
  reason       String?
  // Set when the owner books "any available vet" rather than choosing
  // one — worth knowing when looking at how the feature gets used.
  wasInstantMatch Boolean        @default(false)
  cancelledAt  DateTime?
  cancelledBy  String? // user id, so "who cancelled" survives
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  pet        Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vetProfile VetProfile @relation(fields: [vetProfileId], references: [id], onDelete: Cascade)

  @@index([vetProfileId, startsAt])
  @@index([ownerId, startsAt])
  @@index([petId, startsAt])

  documents Document[]
  note ConsultationNote?
  recording ConsultationRecording?
  
}




enum DocumentKind {
  LAB_REPORT
  PRESCRIPTION
  IMAGING
  VACCINATION_CERT
  CONSULTATION_SNAPSHOT
  OTHER
}

model Document {
  id           String       @id @default(cuid())
  petId        String
  uploadedById String
  appointmentId String?
  kind         DocumentKind @default(OTHER)
  title        String
  note         String?
  // Blob store pathname. The URL is derived from this when needed rather
  // than stored, because a private blob URL is only useful once signed,
  // and a signature has an expiry — persisting one would mean persisting
  // something that stops working.
  pathname     String       @unique
  contentType  String
  sizeBytes    Int
  createdAt    DateTime     @default(now())

  pet         Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([petId, createdAt])
  @@index([appointmentId])
}

enum NoteStatus {
  DRAFT
  FINALISED
}

model ConsultationNote {
  id            String     @id @default(cuid())
  appointmentId String     @unique
  vetProfileId  String
  status        NoteStatus @default(DRAFT)

  scratch String? // typed during the call

  presentingComplaint String?
  examination         String?
  assessment          String?
  plan                String?
  followUpOn          DateTime? @db.Date

  // Once set, the structured fields above are frozen. Corrections go in
  // as amendments rather than edits, because a clinical record that can
  // be silently rewritten is not a record — you cannot tell afterwards
  // what the vet actually knew and said at the time.
  finalisedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  vetProfile    VetProfile      @relation(fields: [vetProfileId], references: [id])
  amendments    NoteAmendment[]
  prescriptions Prescription[]

  @@index([vetProfileId, createdAt])
}

model NoteAmendment {
  id        String   @id @default(cuid())
  noteId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  note   ConsultationNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author User             @relation(fields: [authorId], references: [id])

  @@index([noteId, createdAt])
}
model Prescription {
  id           String  @id @default(cuid())
  noteId       String
  petId        String
  drug         String
  dose         String // "5 mg", "0.5 ml/kg" — units vary too much to model
  frequency    String // "twice daily", "every 8 hours"
  durationDays Int?
  instructions String?
  createdAt    DateTime @default(now())

  note ConsultationNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  pet  Pet              @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, createdAt])
}


enum RecordingStatus {
  UPLOADED
  TRANSCRIBING
  TRANSCRIBED
  FAILED
}

model ConsultationRecording {
  id            String          @id @default(cuid())
  appointmentId String          @unique
  pathname      String          @unique
  contentType   String
  sizeBytes     Int
  durationSeconds Int?
  status        RecordingStatus @default(UPLOADED)

  /// Plain text, for display and for feeding the extraction step.
  transcript String?
  /// Segments with timings and speaker labels, kept so a proposed field
  /// can be traced back to the moment it came from.
  segments   Json?
  /// The structured proposal: presenting complaint, examination,
  /// assessment, plan, medications. Stored as returned, unmodified.
  extraction Json?

  error        String?
  transcribedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status])
}