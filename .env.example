# Copy to .env and fill in. Every value below is a placeholder — none of
# them work as written. .env is gitignored; this file is not, so never
# put a real secret here.

# --- Database (Postgres; the project uses Neon) -------------------------
# The pooled connection string, used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# The direct (non-pooled) connection string. Migrations and the seed use
# this, because schema changes do not work through the pooler. For a
# local Postgres, set both to the same URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Auth.js -------------------------------------------------------------
# Signs session cookies. Generate one with: npx auth secret
AUTH_SECRET="replace-with-32-or-more-random-characters"
# Google OAuth client, from Google Cloud Console > APIs & Services >
# Credentials. Add this redirect URI to the client, for each origin you
# run on:  <origin>/api/auth/callback/google
#   e.g.   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="000000000000-example.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# --- LiveKit (video consultations) --------------------------------------
# The websocket URL of the LiveKit project. NEXT_PUBLIC_ because the
# browser connects to it directly.
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
# Server-side only: used to mint join tokens. Never expose these.
LIVEKIT_API_KEY="replace-with-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-livekit-api-secret"

# --- Vercel Blob (documents, snapshots, recordings) ---------------------
# Read-write token for a *private* Blob store, from the store's page in
# the Vercel dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_STOREID_replace-with-token"

# Read-write token for a second, *public* Blob store, for profile, pet
# and clinic photos. A store is either public or private, so photos
# cannot share the one above.
BLOB_PUBLIC_READ_WRITE_TOKEN="vercel_blob_rw_STOREID_replace-with-token"

# --- Transcription and assistant service (FastAPI) ----------------------
# Base URL of the service, no trailing slash. See
# https://github.com/Prakh4r-S/pet-health-transcription
TRANSCRIPTION_SERVICE_URL="http://localhost:8000"
# Shared secret, sent as a bearer token. Must be the same value the
# service itself is configured to accept.
TRANSCRIPTION_SERVICE_KEY="replace-with-a-long-random-string"

# --- Optional -------------------------------------------------------------
# How long to wait for a transcript before marking it failed, in ms.
# Defaults to 55000; keep it below your function's maximum duration.
# TRANSCRIPTION_TIMEOUT_MS="55000"
